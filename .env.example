# Optional External Database & Feed Integration (Uncomment when connecting external systems)
# DATABASE_URL=postgresql://user:password@localhost:5432/bullis_derivatives
# MONGODB_URI=mongodb://localhost:27017/bullis
# MCX_FEED_API_KEY=your_live_mcx_feed_token_here
# REDIS_URL=redis://localhost:6379

# ==============================================================================
# External Cloud & Market Data Integrations (Optional)
# ==============================================================================

# Supabase Credentials
# SUPABASE_KEY=your_supabase_publishable_or_anon_key
# SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Neon-Tech Cloud PostgreSQL API
# NEON_API_KEY=your_neon_api_key

# Upstash Distributed In-Memory Cache (Redis)
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# UPSTASH_API_KEY=your_upstash_api_key

# GoldAPI.io Physical Spot Benchmark Data
# GOLD_SPOT_API_KEY=your_goldapi_key
# GOLD_SPOT_PROVIDER=goldapi

