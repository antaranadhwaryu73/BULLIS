# ==============================================================================
# BULLIS Institutional Terminal — Environment Configuration Template
# ==============================================================================

# Server Network & Mode
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Security & Rate Limiting
BULLIS_SECRET_KEY=bullis_institutional_sec_key_384029148092_sec_2026
BULLIS_RATE_LIMIT_MAX=120
BULLIS_RATE_LIMIT_WINDOW_MS=60000

# Institutional API Authentication Keys (Seed Tiers)
BULLIS_ANALYST_KEY=bullis_live_analyst_2026
BULLIS_QUANT_KEY=bullis_live_quant_2026
BULLIS_ADMIN_KEY=bullis_live_admin_2026
BULLIS_AUDITOR_KEY=bullis_live_auditor_2026

# Derivatives Microstructure Parameters
RBI_REPO_RATE_PCT=0.068
GOLD_PHYSICAL_STORAGE_PCT=0.005
GOLD_INSURANCE_PCT=0.001
MCX_CTT_TURNOVER_RATE=0.0001
MCX_EXCHANGE_TURNOVER_FEE_RATE=0.000026
MCX_SEBI_TURNOVER_FEE_RATE=0.000001
STAMP_DUTY_TURNOVER_RATE=0.00002
